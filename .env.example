# ─────────────────────────────────────────────────────────────────
#  MRTX STORE — environment
#
#  Copy to .env.local for local dev. In production these go in
#  Vercel → Settings → Environment Variables.
#
#  Everything WITHOUT the NEXT_PUBLIC_ prefix is server-only and must
#  never appear in the browser. src/lib/env.ts imports `server-only`,
#  so the build fails loudly if one is ever pulled into a client
#  component rather than leaking silently.
#
#  .env.local is gitignored. Never commit real values.
# ─────────────────────────────────────────────────────────────────

# ── Razorpay ─────────────────────────────────────────────────────
# Dashboard → Account & Settings → API Keys.
# Use rzp_test_* keys until you have run a full test order.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# Dashboard → Settings → Webhooks → Add New Webhook.
#   URL     https://mrtx.club/api/webhooks/razorpay
#   Events  payment.captured        <- this one is required
#   Secret  any long random string; paste the SAME string here
# The webhook is what actually marks an order paid, decrements stock
# and pushes to Shiprocket. Without it a customer who closes the tab
# after paying gets nothing.
RAZORPAY_WEBHOOK_SECRET=

# Tells the checkout page whether to open the payment modal or say
# plainly that payment is not connected. Set to 1 only once the three
# values above are real. This is public on purpose — it is a flag, not
# a secret, and the server re-checks the real keys regardless.
NEXT_PUBLIC_PAYMENTS_LIVE=0

# ── Supabase ─────────────────────────────────────────────────────
# Project: mrtx-store (ap-south-1). Dashboard → Settings → API.
# The SERVICE ROLE key bypasses row-level security. Every table has RLS
# on with no policies, so this key is the only way in — treat it like a
# database password, because that is what it is.
SUPABASE_URL=https://aywsimktbphyksmykrvg.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Shiprocket ───────────────────────────────────────────────────
# Your Shiprocket login. Settings → API → create an API user and use
# THOSE credentials, not your own dashboard login — an API user can be
# revoked without locking you out.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# Must match a pickup location name in Shiprocket → Settings → Pickup
# Addresses, exactly. A mismatch fails the order push.
SHIPROCKET_PICKUP_LOCATION=Primary
