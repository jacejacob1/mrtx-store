# Copy to .env.local and fill in. Never commit .env.local.
# Add the same names in Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API
SUPABASE_URL=https://aywsimktbphyksmykrvg.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # the "service_role" / secret key — server only

# Razorpay → Account & Settings → API Keys (use Test Mode keys until launch)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Razorpay → Settings → Webhooks → the secret you type when creating the webhook
RAZORPAY_WEBHOOK_SECRET=

# Flip to true the day the GSTIN arrives — tax lines reappear site-wide.
NEXT_PUBLIC_GST_REGISTERED=false
