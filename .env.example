# Copy to .env.local and fill in. Never commit .env.local.
# Add the same names in Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API Keys
SUPABASE_URL=https://aywsimktbphyksmykrvg.supabase.co
# The SECRET key (starts with sb_secret_) — server only. Paste it right after the = sign, no spaces.
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay → Account & Settings → API Keys (Test Mode keys until launch). Not needed for the admin.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay → Settings → Webhooks → the secret you type when creating the webhook
RAZORPAY_WEBHOOK_SECRET=

# Flip to true the day the GSTIN arrives — tax lines reappear site-wide.
NEXT_PUBLIC_GST_REGISTERED=false
